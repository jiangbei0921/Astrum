# 系统与编辑器
.DS_Store
Thumbs.db
desktop.ini
*.swp
.idea/
.vscode/

# 构建产物：由 node tools/build-standalone.js 生成，不入库
# （每次改源码都会产生 1MB 的无意义 diff，需要时一条命令重建）
astrum-standalone.html

# GitHub Pages 发布暂存目录：由 node tools/build-pages.js 生成，不入库
_site/

# 本地临时/调试产物（截图、诊断脚本）
dev/
__*.html
__*.png

# 依赖与构建缓存（本项目零依赖，仅防御）
node_modules/
.cache/

# 真实论文 PDF 样本：按 manifest 下载到本地，不在仓库分发本体
tools/fixtures/pdf-real/

# 本地环境变量与私钥（勿提交任何 key）
.env
.env.*
*.pem
*.key

# 测试运行产生的临时目录（Chrome 配置、临时页面）
__a11y_profile/
__consistency_profile/
__storetest_profile/
__*_tmp.html
__storetest_*.html
